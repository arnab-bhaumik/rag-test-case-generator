# --- LLM provider ---
# which provider llm_client.py uses by default: "groq" or "claude"
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Fallback project for uploading generated "Test Case" issues from a doc-sourced
# run (no ticket to derive a project from). Not needed for Jira-ticket-sourced runs.
JIRA_PROJECT_KEY=

# --- Optional: rerank provider (not required to start) ---
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Local storage ---
CHROMA_DB_DIR=chroma_db
